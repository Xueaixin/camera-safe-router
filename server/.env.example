# The default on Windows is <current-drive>:\camera-safe-routing-data.
# Set only ROUTING_DATA_ROOT for a different external data root. Individual
# path variables below are optional advanced overrides.
# ROUTING_DATA_ROOT=D:\camera-safe-routing-data
# ROUTING_PBF_PATH=D:\camera-safe-routing-data\osm\beijing-latest.osm.pbf
# ROUTING_GRAPH_CACHE_PATH=D:\camera-safe-routing-data\graph-cache\beijing
# CAMERA_JSON_PATH=D:\camera-safe-routing-data\cameras\camera.json
# CAMERA_SNAPSHOT_PATH=D:\camera-safe-routing-data\snapshots
# APP_LOG_FILE=D:\camera-safe-routing-data\logs\camera-safe-routing-server.log
# APP_LOG_ARCHIVE_PATTERN=D:\camera-safe-routing-data\logs\archive\camera-safe-routing-server.%d{yyyy-MM-dd}.%i.log.gz

ROUTING_SAFETY_RADIUS_METERS=30
ROUTING_CALCULATION_THREADS=4
ROUTING_CALCULATION_QUEUE_CAPACITY=16
ROUTING_REQUEST_TIMEOUT=10s
ROUTING_MAX_VISITED_NODES=1000000
# Local demo default. Complete the documented AMap/OSM control-point review before production use.
CAMERA_SOURCE_COORDINATE_VERIFIED=true
CAMERA_MAX_BBOX_RESULTS=10000
CAMERA_MAX_BBOX_SPAN_DEGREES=1.0
# Set true after confirming that production may call the configured data source.
CAMERA_UPDATE_ENABLED=false
CAMERA_UPDATE_SOURCE_URL=https://www.jjz365.cn/CameraData/GetAllRing
CAMERA_UPDATE_CRON=0 15 3 * * *
CAMERA_UPDATE_ZONE=Asia/Shanghai
CAMERA_UPDATE_CONNECT_TIMEOUT=10s
CAMERA_UPDATE_REQUEST_TIMEOUT=30s
CAMERA_UPDATE_MAX_DOWNLOAD_BYTES=10485760
CAMERA_UPDATE_MIN_SOURCE_RECORD_COUNT=1000
CAMERA_UPDATE_MAX_SOURCE_COUNT_CHANGE_RATIO=0.2
CAMERA_UPDATE_MIN_MATCH_RATE=0.98
CAMERA_UPDATE_MAX_BLOCKED_EDGE_CHANGE_RATIO=0.3
CAMERA_UPDATE_BACKUP_RETENTION_COUNT=30
CAMERA_UPDATE_SNAPSHOT_RETENTION_COUNT=20
CAMERA_UPDATE_FAILED_RETENTION_COUNT=20
APP_LOG_MAX_FILE_SIZE=50MB
APP_LOG_MAX_HISTORY=30
APP_LOG_TOTAL_SIZE_CAP=2GB
APP_LOG_CLEAN_HISTORY_ON_START=true
ADMIN_LOCAL_ONLY=true
