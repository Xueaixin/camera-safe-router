# The default on Windows is <current-drive>:\camera-safe-routing-data.
# Set only ROUTING_DATA_ROOT for a different external data root. Individual
# path variables below are optional advanced overrides.
# ROUTING_DATA_ROOT=D:\camera-safe-routing-data
# ROUTING_PBF_PATH=D:\camera-safe-routing-data\osm\beijing-latest.osm.pbf
# ROUTING_GRAPH_CACHE_PATH=D:\camera-safe-routing-data\graph-cache\beijing
# CAMERA_JSON_PATH=D:\camera-safe-routing-data\cameras\map.json
# CAMERA_SNAPSHOT_PATH=D:\camera-safe-routing-data\snapshots

ROUTING_SAFETY_RADIUS_METERS=30
ROUTING_CALCULATION_THREADS=4
ROUTING_CALCULATION_QUEUE_CAPACITY=16
ROUTING_REQUEST_TIMEOUT=10s
ROUTING_MAX_VISITED_NODES=1000000
# Local demo default. Complete the documented AMap/OSM control-point review before production use.
CAMERA_SOURCE_COORDINATE_VERIFIED=true
CAMERA_MAX_BBOX_RESULTS=10000
CAMERA_MAX_BBOX_SPAN_DEGREES=1.0
ADMIN_LOCAL_ONLY=true
